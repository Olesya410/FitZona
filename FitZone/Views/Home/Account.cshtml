@model FitZone.Models.User
@{
    ViewData["Title"] = "Личный кабинет";
    var upcoming = ViewBag.Upcoming as List<FitZone.Models.Booking>;
    var history = ViewBag.History as List<FitZone.Models.Booking>;
    var services = ViewBag.Services as Dictionary<int, string>;
    var trainers = ViewBag.Trainers as Dictionary<int, string>;
    var profOk = TempData["ProfileOk"] != null;
    var profError = TempData["ProfileError"] as string;
    var bookOk = TempData["BookingOk"] != null;
    var bookError = TempData["BookingError"] as string;
}

<section class="page-hero">
    <div class="container">
        <div>
            <h1>Личный кабинет</h1>
            <p>Ваши записи и профиль в одном месте.</p>
            </div>
            <img src="~/img/cat-thumb.png" alt="">
        </div>
</section>
<section class="section">
    <div class="container">
        <div id="userView" class="cabinet">
            <aside class="panel profile-card">
                <img src="~/img/logo.png" alt="FITZONE" style="height:44px;margin:0 auto 16px">
                <h3>@Model.FullName</h3><p class="muted">@Model.Email</p>
                <form class="form" id="profileForm" method="post" asp-action="UpdateProfile" style="text-align:left">
                    <div class="notice notice--ok @(profOk ? "" : "hidden")">Профиль обновлён!</div>
                    <div class="notice notice--warn @(profError == null ? "hidden" : "")" role="alert">@profError</div>
                    <div class="field"><label for="pfName">Имя</label><input id="pfName" name="fullName" type="text" value="@Model.FullName" required minlength="2"><p class="error"></p></div>
                    <div class="field"><label for="pfPhone">Телефон</label><input id="pfPhone" name="phone" type="tel" value="@Model.Phone" pattern="\+?[\d\s()\-]{10,18}" title="Неверный формат телефона"><p class="error"></p></div>
                    <button class="btn btn--dark btn--sm" type="submit">Сохранить</button>
                </form>
                <div style="margin-top:16px"><form asp-controller="Home" asp-action="Logout" method="post" style="display:inline"><button class="btn btn--outline btn--sm" type="submit">Выйти</button></form></div>
            </aside>
            <div class="panel tabgroup">
                <input class="tab-radio" type="radio" name="tab" id="tab-up" checked><input class="tab-radio" type="radio" name="tab" id="tab-hist">
                <div class="tabs"><label class="tab" for="tab-up">Предстоящие записи</label><label class="tab" for="tab-hist">История</label></div>

                <div class="notice notice--ok @(bookOk ? "" : "hidden")">Запись отменена.</div>
                <div class="notice notice--warn @(bookError == null ? "hidden" : "")" role="alert">@bookError</div>

                <ul class="list" data-pane="up" id="upList">
                    @if (upcoming != null && upcoming.Any())
                    {
                        foreach (var b in upcoming)
                        {
                            <li>
                                <span><b>@(services != null && services.ContainsKey(b.ServiceId) ? services[b.ServiceId] : "Услуга")</b><br><small>@b.TrainingDate.ToString("dd.MM.yyyy") @b.TrainingTime.ToString(@"hh\:mm") · @(trainers != null && trainers.ContainsKey(b.TrainerId) ? trainers[b.TrainerId] : "Тренер")</small></span>
                                <span>
                                    <span class="status status--ok">@b.Status</span>
                                    <form method="post" asp-action="CancelBooking" style="display:inline"><input type="hidden" name="cancelId" value="@b.Id"><button class="btn btn--outline btn--sm" type="submit">Отменить</button></form>
                                </span>
                            </li>
                        }
                    }
                    else
                    {
                        <li><span class="muted">У вас пока нет предстоящих записей.</span></li>
                    }
                </ul>
                <ul class="list" data-pane="hist" id="histList">
                    @if (history != null && history.Any())
                    {
                        foreach (var b in history)
                        {
                            <li>
                                <span><b>@(services != null && services.ContainsKey(b.ServiceId) ? services[b.ServiceId] : "Услуга")</b><br><small>@b.TrainingDate.ToString("dd.MM.yyyy") @b.TrainingTime.ToString(@"hh\:mm") · @(trainers != null && trainers.ContainsKey(b.TrainerId) ? trainers[b.TrainerId] : "Тренер")</small></span>
                                <span><span class="status status--ok">@b.Status</span></span>
                            </li>
                        }
                    }
                    else
                    {
                        <li><span class="muted">История записей пуста.</span></li>
                    }
                </ul>
                <p class="muted"><small>Отмена записи возможна не позднее чем за 24 часа до начала.</small></p>
            </div>
        </div>
    </div>
</section>
