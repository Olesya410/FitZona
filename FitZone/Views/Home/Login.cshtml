@{
    ViewData["Title"] = "Вход";
}

<section class="page-hero"><div class="container"><div><h1>Вход</h1><p>Войдите, чтобы записываться на тренировки, смотреть историю и оставлять отзывы.</p></div><img src="~/img/cat-thumb.png" alt=""></div></section>
<section class="section"><div class="container"><div class="auth-box panel">
 <img src="~/img/logo.png" alt="FITZONE" style="height:48px;margin:0 auto 20px">
 <h2 style="text-align:center;font-size:2rem">Вход</h2>
 <form class="form" id="loginForm" method="post">
  @if (ViewData["Error"] is string loginError){<div class="notice notice--warn" role="alert">@loginError</div>}
  <div class="field"><label for="lEmail">E-mail</label><input id="lEmail" name="email" type="email" autocomplete="email" required><p class="error"></p></div><div class="field"><label for="lPass">Пароль</label><input id="lPass" name="password" type="password" autocomplete="current-password" required><p class="error"></p></div>
  <button class="btn btn--pink" type="submit">Войти</button>
  <p>Нет аккаунта? <a asp-controller="Home" asp-action="Register"><u>Зарегистрироваться</u></a></p>
 </form>
</div></div></section>
