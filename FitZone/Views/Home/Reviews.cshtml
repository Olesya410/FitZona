@model List<Review>
@{
    ViewData["Title"] = "Отзывы";
    var average = Model.Count > 0 ? Model.Average(r => r.Rating) : 0;
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<section class="page-hero"><div class="container"><div><h1>Отзывы наших клиентов</h1><p>Честные слова от тех, кто уже тренируется с нами.</p></div><img src="~/img/cat-lying.png" alt=""></div></section>
<section class="section"><div class="container">
 <div class="toolbar"><h3 id="avgRating">@average.ToString("0.0") / 5 · отзывов: @Model.Count</h3></div>
 <div class="grid grid--2" id="reviewList">
  @foreach (var r in Model)
  {
   <article class="card review">
    <div class="review__top"><h3>@r.AuthorName</h3><span class="stars" aria-label="Оценка @r.Rating из 5">@(new string('★', r.Rating))<span class="off">@(new string('★', 5 - r.Rating))</span></span></div>
    <small class="muted">@r.ReviewDate.ToString("dd.MM.yyyy")</small>
    <p>@r.Comment</p>
   </article>
  }
 </div>
</div></section>
<section class="section section--white"><div class="container">
 <div class="panel" style="max-width:720px;margin:auto">
  <h2>Оставить отзыв</h2>
  <div class="notice notice--warn @(signedIn ? "hidden" : "")" id="reviewLogin">Оставлять отзывы могут только авторизованные пользователи. <a asp-controller="Home" asp-action="Login"><u>Войти</u></a> или <a asp-controller="Home" asp-action="Register"><u>зарегистрироваться</u></a></div>
  @if (TempData["ReviewError"] is string reviewError){<div class="notice notice--warn" role="alert">@reviewError</div>}
  @if (signedIn)
  {
  <form class="form" id="reviewForm" method="post">
   <div class="field"><span class="label">Ваша оценка</span>
    <div class="rating-input">
     <input type="radio" name="rating" id="s5" value="5" required><label for="s5" title="5">★</label>
     <input type="radio" name="rating" id="s4" value="4"><label for="s4" title="4">★</label>
     <input type="radio" name="rating" id="s3" value="3"><label for="s3" title="3">★</label>
     <input type="radio" name="rating" id="s2" value="2"><label for="s2" title="2">★</label>
     <input type="radio" name="rating" id="s1" value="1"><label for="s1" title="1">★</label>
    </div><p class="error" id="ratingError"></p></div>
   <div class="field"><label for="rvText">Ваш отзыв</label><textarea id="rvText" name="text" required minlength="10"></textarea><p class="error"></p></div>
   <button class="btn btn--pink" type="submit">Отправить отзыв</button>
  </form>
  }
  <div class="notice @(TempData["ReviewOk"] != null ? "" : "hidden")" id="reviewModeration" role="alert">Спасибо! Отзыв отправлен на модерацию и появится после проверки.</div>
 </div>
</div></section>
