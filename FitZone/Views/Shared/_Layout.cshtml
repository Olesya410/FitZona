<!DOCTYPE html>
<html lang="ru">
<head>
    @await Html.PartialAsync("_MetaPartial")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">
    @await Html.PartialAsync("_CssPartial")
</head>
<body>
    @await Html.PartialAsync("_HeaderPartial")
    <main>
        @RenderBody()
    </main>
    @await Html.PartialAsync("_FooterPartial")
</body>
</html>
